{
  "name": "@crawlora-org/opendota",
  "version": "0.1.0",
  "description": "Crawlora OpenDota API client with 30 endpoints for Dota 2 matches, heroes, players, teams, leagues, statistics, and game constants",
  "homepage": "https://crawlora.net/?utm_source=npm&utm_medium=referral&utm_campaign=platform-clients&utm_content=opendota-javascript-homepage",
  "bugs": { "url": "https://github.com/Crawlora-org/crawlora-opendota/issues" },
  "keywords": ["crawlora", "api-client", "sdk", "web-scraping", "scraping-api", "opendota", "opendota-api", "opendota-scraper", "opendota-data", "opendota-dota-2-matches", "opendota-heroes", "opendota-players", "opendota-teams", "opendota-leagues", "opendota-statistics", "opendota-game-constants"],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crawlora-org/crawlora-opendota",
    "directory": "javascript"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "generate": "python3 ../scripts/generate.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
